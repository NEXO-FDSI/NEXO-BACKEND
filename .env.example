# Fuentes de enriquecimiento. OTX es obligatoria; ThreatFox y VirusTotal son opcionales
# (sin clave aparecen como "no configuradas").
REPUTATION_API_KEY=
# Auth-Key gratuita: https://auth.abuse.ch/
THREATFOX_API_KEY=
# API pública: https://www.virustotal.com (4 consultas/min)
VIRUSTOTAL_API_KEY=
DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
TEST_DATABASE_URL=postgresql+psycopg://postgres:test@localhost:5433/nexo_test
# IA: cualquier endpoint compatible con OpenAI. Primario → respaldo si falla.
# Perfil recomendado para la demo: Groq primario (≈1 s) + Ollama local de respaldo.
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b
# Vacío = no se envía. qwen3 acepta "none"; gpt-oss solo low/medium/high (con "none" da 400).
LLM_REASONING_EFFORT=none
LLM_TIMEOUT=20
# Vacío = sin respaldo.
LLM_FALLBACK_PROVIDER=ollama
LLM_FALLBACK_BASE_URL=http://localhost:11434/v1
LLM_FALLBACK_API_KEY=ollama
LLM_FALLBACK_MODEL=qwen3:8b
LLM_FALLBACK_REASONING_EFFORT=none
LLM_FALLBACK_TIMEOUT=60
# Otros perfiles posibles, sin cambiar código:
#   Solo local:  LLM_PROVIDER=ollama LLM_BASE_URL=http://localhost:11434/v1 LLM_API_KEY=ollama LLM_MODEL=qwen3:8b
#   OpenRouter:  LLM_PROVIDER=openrouter LLM_BASE_URL=https://openrouter.ai/api/v1 LLM_MODEL=<proveedor/modelo> LLM_REASONING_EFFORT=
# Embeddings (solo para sembrar Chroma): endpoint propio, Groq no ofrece embeddings.
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=nomic-embed-text
CHROMA_PERSIST_DIR=./data/chroma
